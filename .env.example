# Kelvin6K Unified Configuration Example
# Copy this file to .env and configure your keys

# Text-to-speech (offline pyttsx3 by default or ElevenLabs cloud)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=Rachel

# Conversational AI & Multimodal Brain (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Alternative LLM Brain (Anthropic Claude - optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Core Polling & Timers
POLL_INTERVAL_SECONDS=5
PIPE_CLEAN_INTERVAL_SECONDS=120
MAINTENANCE_INTERVAL_SECONDS=300

# Camera & Metrology (Optional IP / RTSP Camera Settings)
CAMERA_INDEX=0
CAMERA_URL=
CAMERA_USERNAME=
CAMERA_PASSWORD=

# SQLite Database Path
DATABASE_PATH=kelvin6k.db
