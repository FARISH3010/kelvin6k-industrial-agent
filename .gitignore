# ==============================================================================
# Kelvin6K Industrial Agent - .gitignore
# ==============================================================================

# --- Secrets, API Keys & Environment Variables ---
.env
.env.*
!.env.example
*.env

# --- Python Virtual Environments & Packages ---
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.tox/

# --- Frontend Dependencies & Builds ---
ui/node_modules/
ui/dist/
ui/.env.local
ui/.env.*.local
node_modules/
dist/

# --- Ephemeral Database Backups (exclude timestamps, keep kelvin6k.db) ---
*.db.bak.*
*.sqlite3.bak.*

# --- OS-specific & Editor Temporary Files ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
